<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{TITLE}} &middot; Mochi Factory Blog</title>
<meta name="description" content="{{DESCRIPTION}}">
<meta property="article:published_time" content="{{DATE}}">
<meta name="ptk:reading-minutes" content="{{MINUTES}}">
<link rel="canonical" href="https://mochi-factory.com/blog/{{SLUG}}/">
<link rel="alternate" type="application/rss+xml" title="Mochi Factory Blog" href="/blog/feed.xml">
<meta property="og:type" content="article">
<meta property="og:title" content="{{TITLE}}">
<meta property="og:description" content="{{DESCRIPTION}}">
<meta property="og:url" content="https://mochi-factory.com/blog/{{SLUG}}/">
<link rel="stylesheet" href="../../assets/site.css">
<link rel="stylesheet" href="../../assets/blog.css">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BlogPosting","headline":"{{TITLE}}","description":"{{DESCRIPTION}}","datePublished":"{{DATE}}","url":"https://mochi-factory.com/blog/{{SLUG}}/","author":{"@type":"Organization","name":"Mochi Factory","url":"https://mochi-factory.com/"},"publisher":{"@type":"Organization","name":"Mochi Factory"}}
</script>
</head>
<body>
<div class="page">
  <header>
    <p class="eyebrow"><a href="../../">Mochi Factory</a> &middot; <a href="../">Blog</a></p>
    <h1 class="page-title">{{TITLE}}</h1>
    <p class="post-meta"><time datetime="{{DATE}}">{{DATE_HUMAN}}</time> &middot; {{MINUTES}} min read</p>
  </header>

  <article class="post-body">
{{BODY_HTML}}
  </article>

  <aside class="post-callout">
    <h2>{{PRODUCT_NAME}}</h2>
    <p>{{PRODUCT_LINE}}</p>
    <p><a href="{{PRODUCT_URL}}?utm_source=ptk-studio&amp;utm_medium=blog&amp;utm_campaign={{PROJECT}}-2027">{{PRODUCT_CTA}} &#8594;</a></p>
    <p class="disclosure">Disclosure: {{PRODUCT_NAME}} is made by Mochi Factory, run by PTK Studio.</p>
  </aside>

  <footer>
    <p><a href="../">&#8592; All posts</a> <span class="dot">&middot;</span> <a href="/blog/feed.xml">RSS</a></p>
    <p><a href="mailto:hello@mochi-factory.com">hello@mochi-factory.com</a> <span class="dot">&middot;</span> <a href="/privacy/">Privacy</a> &middot; <a href="#" id="ptk-consent">Usage stats</a></p>
  </footer>
</div>
<script src="/assets/ptk-analytics.js" defer></script>
</body>
</html>
